// A jk (Jack Kilby) flip-flop which is sync clear at posedge can be set and reset and by creating a versatile memory element, invalid state is prevented.



module jkff_pulse_triggered_behavioral (
    input  wire j,
    input  wire k,
    input  wire clk,
    input  wire clrbar,
    output reg  q,
    output wire qbar
);

    parameter NOCHANGE = 2'b00,
              RESET    = 2'b01,
              SET      = 2'b10,
              TOGGLE   = 2'b11;
    
    assign qbar = ~q;


//JK FLIP-FLOP WITH SYNC CLEAR
    always @(posedge clk) begin
        
        if (~clrbar) begin
            q <= 1'b0;
        end else begin
    
        case ({j,k})
            NOCHANGE: q <= q;        
            RESET   : q <= 1'b0;     
            SET     : q <= 1'b1;     
            TOGGLE  : q <= ~q;       


        endcase
        end
     
     end

endmodule
