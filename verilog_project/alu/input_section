
//1.INPUT_SECTION

module input_section(
input a,b,
input s3,s2,s1,s0,
output out1,out2
);

assign out1 = ~( (a & b & s3) | (a & ~b & s2) );
assign out2 = ~( a | (~b & s1) | (b & s0) ); 

endmodule



//2. INVERT_M

module invert_m(
input a,
output y
);

assign y = ~a;

endmodule



//3. OUT_SECTION

module out_section_out0(
input input0_out1,
input input0_out2,
input m_bar,
input ci_bar,
output f0
);

assign f0 = (input0_out1 ^ input0_out2) ^ ~(ci_bar & m_bar);


endmodule


module out_section_out1(
input input1_out1,
input input1_out2,
input input0_out2,
input m_bar,
input ci_bar,
output f1
);

assign f1 = (input1_out1 ^ input1_out2) ^ ~(ci_bar & input0_out2 & m_bar);


endmodule


module out_section_out2(
input input2_out1,
input input2_out2,
input input1_out1,
input input1_out2,
input input0_out2,
input m_bar,
input ci_bar,
output f2
);

assign f2 = (input2_out1 ^ input2_out2) ^ ~( (ci_bar & input1_out1 & input0_out2 & m_bar) | 
            (input1_out2 & m_bar) );


endmodule



module out_section_out3(
input input3_out1,
input input3_out2,
input input2_out1,
input input2_out2,
input input1_out1,
input input1_out2,
input input0_out2,
input m_bar,
input ci_bar,
output f3
);

assign f3 = (input2_out1 ^ input2_out2) ^ ~( (ci_bar & input2_out1 & input1_out1 & input0_out2 & m_bar) | 
            (input2_out1 & input1_out2 & m_bar)| 
            (input2_out2 & m_bar));


endmodule



//4.aeqb (a equal b,but only at speific function ex. ~(A ^ B) )

module aeqb(
input f3, f2, f1, f0,
output aeqb
);

assign aeqb = f3 & f2 & f1 & f0;


endmodule



//4. GPC SECTION ( GENERATE, PROPAGATE, CARRY )

module GPC_section(
input  input3_out1,
input  input3_out2,
input  input2_out1,
input  input2_out2,
input  input1_out1,
input  input1_out2,
input  input0_out1,
input  input0_out2,
input  ci_bar,
output y, co_bar, x
);


y =  ~ ( input3_out2 | (input3_out1 & input2_out2) | (input3_out1 & input2_out1 & input1_out2) | (input3_out1 & input2_out1 & input1_out1 & input0_out2) );

co_bar = ~y | (input3_out1 & input2_out1 & input1_out1 & input0_out1 & ci_bar); 

x = ~ (input3_out1 & input2_out1 & input1_out1 & input0_out1);

endmodule



